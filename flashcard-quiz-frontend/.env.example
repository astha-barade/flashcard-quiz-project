# Where your Spring Boot backend runs.
VITE_API_BASE_URL=http://localhost:8080

# In development, send requests through Vite's built-in proxy instead of
# calling the backend directly from the browser. This avoids CORS problems
# (the backend's SecurityConfig does not enable CORS for protected endpoints).
# Set to false to call VITE_API_BASE_URL directly.
VITE_USE_DEV_PROXY=true
